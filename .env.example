# TheMovieDB API Configuration
# Obtén tu API key/token en: https://www.themoviedb.org/settings/api
# Puedes usar:
#   - API Key (v3): Una cadena corta alfanumérica
#   - Read Access Token (v4): Un JWT que empieza con "eyJ..."
# Ambos funcionan automáticamente.
# 
# NOTA: Si no configuras esta variable, la aplicación usará mock data automáticamente
VITE_TMDB_API_KEY=tu_api_key_o_bearer_token_aqui

# API URLs (Opcional - valores por defecto mostrados)
VITE_TMDB_API_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Base path para GitHub Pages (solo necesario si despliegas en un subdirectorio)
# Ejemplo: Si tu repo se llama "mi-proyecto", usa: /mi-proyecto/
# VITE_BASE_PATH=/
